# Docker Environment Configuration
# Copy this file to .env.local and fill in your actual values for development

NODE_ENV=production

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# Resend (email notifications - optional, sending is skipped with a warning if unset)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=notifiche@yourdomain.com

# Canonical site URL - used both for SEO metadata (lib/seo.ts) and to build the absolute
# links (CTA button, header logo, notification-preferences link) inside notification emails.
# Optional: falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL on Vercel, then to
# http://localhost:3000. Set explicitly once a custom domain is live so emails link to it
# instead of the Vercel deployment URL.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Firebase Cloud Messaging (push notifications - optional, sending is skipped with a warning if
# unset). The full service account JSON (Firebase console > Project settings > Service accounts >
# Generate new private key), as a single-line string - not the client-side google-services.json
# from the Flutter app, which is a different, non-secret file.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

# Google OAuth (if used)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cron jobs (reveal-expired-reviews - see vercel.json). Optional locally;
# when set, the route only accepts requests carrying a matching
# "Authorization: Bearer <CRON_SECRET>" header (Vercel Cron sends this
# automatically once the env var is configured on the project).
CRON_SECRET=your_cron_secret
