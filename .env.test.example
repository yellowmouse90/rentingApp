# Copy this file to .env.test and fill in your own Stripe test-mode keys.
# .env.test itself is gitignored (it ends up holding a real Stripe secret key, even if test-mode)
# - see the comment in .gitignore.
#
# Used for running the app against the local Supabase stack (pnpm test:db:up / test:db:reset) via
# Playwright. The Supabase values below are the fixed keys `supabase start` always prints for a
# local stack - not secrets, safe to leave as-is (see
# https://supabase.com/docs/guides/local-development).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Stripe: your own test-mode keys (dashboard > Developers > API keys, with "Test mode" on).
# tests/e2e/helpers/stripe.ts creates a throwaway Connect test account via this key at test time.
STRIPE_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# Any string works here - it's a local HMAC secret for signing test webhook payloads
# (stripe.webhooks.generateTestHeaderString), not something Stripe issues or validates.
STRIPE_WEBHOOK_SECRET=whsec_test_any_string_here

# Explicitly blanked (not just absent): Next.js loads .env.local itself whenever a var isn't
# already defined in process.env, so without this, tests would silently pick up the *real*
# RESEND_API_KEY from .env.local and send real emails through the real Resend account to fake
# @example.com test addresses. An empty string here counts as "already defined" and blocks that.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
